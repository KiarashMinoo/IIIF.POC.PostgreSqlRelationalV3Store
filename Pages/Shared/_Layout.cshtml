<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · IIIF Relational V3 Store</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <a asp-page="/Manifests/Index" class="brand">IIIF Relational V3 Store</a>
    <nav>
        <a asp-page="/Manifests/Index">Manifests</a>
        <a asp-page="/Manifests/Create" class="primary-link">Add Manifest</a>
    </nav>
</header>
<main class="shell">
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="status-message">@message</div>
    }
    @RenderBody()
</main>
<footer>Proof of concept: Razor Pages, EF Core owned entities, PostgreSQL, and IIIF Presentation API 3.</footer>
</body>
</html>
