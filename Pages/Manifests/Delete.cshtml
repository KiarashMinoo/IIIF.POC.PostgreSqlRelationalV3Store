@page "{id:guid}"
@model IIIF.POC.PostgreSqlRelationalV3Store.Pages.Manifests.DeleteModel
@{ ViewData["Title"] = "Delete Manifest"; }
<section class="card narrow danger-zone">
    <span class="eyebrow">DELETE</span>
    <h1>Delete this Manifest?</h1>
    <p>Deleting the aggregate cascades through all owned tables. The POC does not keep revisions or soft-deleted records.</p>
    <dl>
        <dt>Label</dt><dd>@Model.Label</dd>
        <dt>IIIF id</dt><dd class="wrap"><code>@Model.Manifest.IiifId</code></dd>
        <dt>Canvases</dt><dd>@Model.Manifest.Items.Count</dd>
    </dl>
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <form method="post">
        <input asp-for="Version" type="hidden" />
        <button type="submit" class="danger">Delete aggregate</button>
        <a asp-page="Details" asp-route-id="@Model.Manifest.Id" class="button secondary">Cancel</a>
    </form>
</section>
